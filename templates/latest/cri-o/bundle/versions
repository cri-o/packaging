#!/usr/bin/env bash
set -euox pipefail

# Versions to be used
declare -A VERSIONS=(
    ["cni-plugins"]=v1.9.1
    ["conmon"]=v2.2.1
    ["conmon-rs"]=v0.8.0
    ["cri-tools"]=v1.37.0
    ["crun"]=1.30.1
    ["runc"]=v1.5.2
    ["crio-credential-provider"]=v0.1.2
)
# TODO: remove the conditional overrides and set the default to the newest
# conmon-rs once CRI-O v1.37 goes EOL.
# conmon-rs v1.0.0+ requires CRI-O v1.37+, v1.1.0+ is used by CRI-O v1.38+
if [[ "${PROJECT_VERSION:-}" == "main" ]]; then
    VERSIONS["conmon-rs"]=v1.1.1
elif [[ "${PROJECT_VERSION:-}" =~ ^v([0-9]+)\.([0-9]+)$ ]]; then
    if [[ ${BASH_REMATCH[1]} -ge 2 || (${BASH_REMATCH[1]} -eq 1 && ${BASH_REMATCH[2]} -ge 38) ]]; then
        VERSIONS["conmon-rs"]=v1.1.1
    elif [[ ${BASH_REMATCH[1]} -eq 1 && ${BASH_REMATCH[2]} -eq 37 ]]; then
        VERSIONS["conmon-rs"]=v1.0.1
    fi
fi

export VERSIONS
