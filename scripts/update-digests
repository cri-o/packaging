#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")"/helpers
source "$(dirname "${BASH_SOURCE[0]}")"/bundle/components

GIT_ROOT=$(git rev-parse --show-toplevel)
VERSIONS_FILE="$GIT_ROOT/templates/latest/cri-o/bundle/versions"
DIGESTS_FILE="$GIT_ROOT/scripts/bundle/digests"

ARCHES=(amd64 arm64 ppc64le s390x)

# The versions file picks a different conmon-rs depending on the CRI-O release,
# so digests have to be pinned for every version that can be selected.
# TODO: reduce to "main" once CRI-O v1.36 goes EOL.
PROJECT_VERSIONS=(main v1.36)

collect_versions() {
    (
        PROJECT_VERSION=$1
        export PROJECT_VERSION
        # shellcheck source=../templates/latest/cri-o/bundle/versions
        source "$VERSIONS_FILE"
        for NAME in "${!VERSIONS[@]}"; do
            echo "$NAME=${VERSIONS[$NAME]}"
        done
    )
}

mapfile -t PAIRS < <(
    for PROJECT_VERSION in "${PROJECT_VERSIONS[@]}"; do
        collect_versions "$PROJECT_VERSION"
    done | sort -u
)

WORKDIR=$(mktemp -d)
trap 'rm -rf -- "$WORKDIR"' EXIT
ARTIFACT="$WORKDIR/artifact"

# Assemble in a scratch file so that a failed download cannot leave a truncated
# digest file behind
OUTPUT="$WORKDIR/digests"

{
    echo "#!/usr/bin/env bash"
    echo
    echo "# SHA256 digests of the components bundled next to CRI-O."
    echo "#"
    echo "# Generated by scripts/update-digests, do not edit by hand. Run that script"
    echo "# after changing any version in templates/latest/cri-o/bundle/versions."
    echo
    echo "declare -A DIGESTS=("
} >"$OUTPUT"

for PAIR in "${PAIRS[@]}"; do
    NAME=${PAIR%%=*}
    VERSION=${PAIR#*=}

    for ARCH in "${ARCHES[@]}"; do
        URL=$(component_url "$NAME" "$VERSION" "$ARCH")
        echo "Hashing $NAME $VERSION ($ARCH)" >&2
        curl_retry "$URL" -o "$ARTIFACT"
        DIGEST=$(sha256sum "$ARTIFACT" | cut -d' ' -f1)
        echo "    [\"$NAME-$VERSION-$ARCH\"]=$DIGEST" >>"$OUTPUT"
    done
done

{
    echo ")"
    echo
    echo "export DIGESTS"
} >>"$OUTPUT"

mv "$OUTPUT" "$DIGESTS_FILE"
echo "Wrote $DIGESTS_FILE" >&2
