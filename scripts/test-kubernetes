#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")"/vars

TYPE=${TYPE:-}
TESTDIR="test/$TYPE"

if [[ $TYPE == "" ]]; then
    echo "TYPE is not set"
    exit 1
fi

# Consumed by the Vagrantfile and passed on to test/scripts/versions.sh, so
# that the VM installs the packages built for this revision.
PROJECT_PATH="$PROJECT_TYPE:/$PROJECT_VERSION"
export PROJECT_PATH
echo "Testing packages from project path: $PROJECT_PATH"

# Start from a fresh machine on every attempt, because a vagrant up on an
# already provisioned machine skips the tests and succeeds. Chain the commands,
# set -e does not apply within the if condition of retry_3.
vagrant_up() {
    if vagrant destroy -f && vagrant up; then
        return
    fi
    # The serial console of the machine, if the Vagrantfile logs it.
    cat .vagrant/console.log 2>/dev/null || true
    return 1
}

pushd "$TESTDIR"
retry_3 vagrant_up
