#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")"/vars

# Setup a tmp work dir, plus a separate one for the patched templates so that
# they stay out of the krel workspace. Not called TMPDIR, an exported one would
# make mktemp create the template dir inside of the workspace.
WORKDIR="$(mktemp -d)"
TEMPLATE_WORKDIR="$(mktemp -d)"
trap 'sudo rm -rf -- "$WORKDIR" "$TEMPLATE_WORKDIR"' EXIT
pushd "$WORKDIR"

# Package options
TEMPLATE_DIR="$GIT_ROOT/templates/latest"
PACKAGE=cri-o
RUN_RELEASE=${RUN_RELEASE:-0}

export OBS_USERNAME=cri-o-release-bot

obs_stage() {
    # Patch the package metadata to download the latest commit for non tags.
    # Work on a copy, patching the checked out template would leave the tree
    # dirty for everything running after this.
    local template_dir="$TEMPLATE_WORKDIR/latest"
    cp -r "$TEMPLATE_DIR" "$template_dir"

    if ! [[ "$REVISION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        sed -i 's;gs://cri-o/artifacts/cri-o.{{ .Architecture }}.v{{ .PackageVersion }}.tar.gz;gs://cri-o/artifacts/cri-o.{{ .Architecture }}.'"$COMMIT"'.tar.gz;g' "$template_dir/metadata.yaml"
    fi
    echo "Staging https://build.opensuse.org/package/show/$PROJECT/$PACKAGE"

    # Push the sources
    krel obs stage \
        --log-level debug \
        --workspace . \
        --template-dir "$template_dir" \
        --packages "$PACKAGE" \
        --project "$PROJECT" \
        --version "$VERSION" \
        --submit=false \
        --nomock
}

obs_release() {
    krel obs release \
        --log-level debug \
        --workspace . \
        --template-dir "$TEMPLATE_DIR" \
        --packages "$PACKAGE" \
        --project "$PROJECT" \
        --submit=false \
        --nomock
}

install_osc
install_krel

if [[ $RUN_RELEASE == 0 ]]; then
    obs_stage
else
    obs_release
fi
