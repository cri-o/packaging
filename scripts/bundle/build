#!/usr/bin/env bash

source "$(dirname "${BASH_SOURCE[0]}")"/../vars

TEMPLATES_DIR="$GIT_ROOT/templates/latest/cri-o/bundle"

# shellcheck source=../../templates/latest/cri-o/bundle/versions
source "$TEMPLATES_DIR/versions"

# shellcheck source=components
source "$(dirname "${BASH_SOURCE[0]}")"/components

# shellcheck source=digests
source "$(dirname "${BASH_SOURCE[0]}")"/digests

ARCH_AMD64=amd64
ARCH_ARM64=arm64
ARCH_PPC64LE=ppc64le
ARCH_S390X=s390x
ARCH=${ARCH:-$ARCH_AMD64}

ARCHIVE_ID=$COMMIT
if [[ $PROJECT_TYPE == stable ]]; then
    ARCHIVE_ID="$REVISION"
fi
ARCHIVE="cri-o.$ARCH.$ARCHIVE_ID.tar.gz"
ARCHIVE_SHA256SUM="$ARCHIVE.sha256sum"

mkdir -p "$ARCHIVE_PATH"
CRIODIR=cri-o
TMPDIR="$ARCHIVE_PATH/$CRIODIR"
rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"/{bin,contrib,etc,man}

BIN_URL="https://storage.googleapis.com/cri-o/artifacts/$COMMIT/$ARCH"
FILES_BIN=(
    crio
    pinns
)

for FILE in "${FILES_BIN[@]}"; do
    DEST_PATH="$TMPDIR/bin/$FILE"
    curl_retry "$BIN_URL/$FILE" -o "$DEST_PATH"
    chmod +x "$DEST_PATH"
done

TMPDIR_CRIO="$(mktemp -d)"
trap 'rm -rf -- "$TMPDIR_CRIO"' EXIT
curl_retry "https://github.com/cri-o/cri-o/archive/$COMMIT.tar.gz" -o- |
    tar xfz - -C "$TMPDIR_CRIO" --strip-components=1

cp -r "$TMPDIR_CRIO/completions" "$TMPDIR"

make -C "$TMPDIR_CRIO" docs
FILES_MAN=(
    "$TMPDIR_CRIO/docs/crio.8"
    "$TMPDIR_CRIO/docs/crio.conf.5"
    "$TMPDIR_CRIO/docs/crio.conf.d.5"
)

for FILE in "${FILES_MAN[@]}"; do
    cp "$FILE" "$TMPDIR/man"
done

FILES_ETC=(
    "$TEMPLATES_DIR/10-crio.conf"
    "$TMPDIR_CRIO/crictl.yaml"
    "$TMPDIR_CRIO/crio-umount.conf"
    "$TMPDIR_CRIO/contrib/sysconfig/crio"
)

for FILE in "${FILES_ETC[@]}"; do
    cp "$FILE" "$TMPDIR/etc"
done

FILES_CONTRIB=(
    "$TEMPLATES_DIR/10-crio-bridge.conflist.disabled"
    "$TEMPLATES_DIR/crio.service"
    "$TEMPLATES_DIR/policy.json"
    "$TEMPLATES_DIR/registries.conf"
)

for FILE in "${FILES_CONTRIB[@]}"; do
    cp "$FILE" "$TMPDIR/contrib"
done

sed -i 's;PREFIX;/usr/local/bin;g' "$TMPDIR/contrib/crio.service"

cp "$TEMPLATES_DIR/Makefile" "$TMPDIR"
cp "$TEMPLATES_DIR/README.md" "$TMPDIR"
cp "$TEMPLATES_DIR/install" "$TMPDIR/install"
sed -i "s/-amd64/-$ARCH/" "$TMPDIR/install"
cp "$TMPDIR_CRIO/LICENSE" "$TMPDIR"

# Verify a downloaded component against its pinned digest. Bundled components
# are the only inputs that are not already covered by a signature, so a
# mismatch has to be fatal.
verify_digest() {
    local name=$1 version=$2 path=$3 key expected actual
    key="$name-$version-$ARCH"
    expected=${DIGESTS[$key]:-}

    if [[ $expected == "" ]]; then
        echo "No pinned digest for $key"
        echo "Run scripts/update-digests after changing component versions"
        exit 1
    fi

    actual=$(sha256sum "$path" | cut -d' ' -f1)
    if [[ $actual != "$expected" ]]; then
        echo "Digest mismatch for $key"
        echo "  expected: $expected"
        echo "  actual:   $actual"
        exit 1
    fi

    echo "Verified digest for $key"
}

download_component() {
    local name=$1 dest=$2 version url
    version=${VERSIONS[$name]}
    url=$(component_url "$name" "$version" "$ARCH")
    curl_retry "$url" -o "$dest"
    verify_digest "$name" "$version" "$dest"
}

TMP_BIN=$TMPDIR/bin

# conmon
download_component conmon "$TMP_BIN/conmon"
chmod +x "$TMP_BIN/conmon"

# conmon-rs
download_component conmon-rs "$TMP_BIN/conmonrs"
chmod +x "$TMP_BIN/conmonrs"

# runc
download_component runc "$TMP_BIN/runc"
chmod +x "$TMP_BIN/runc"

# crun
download_component crun "$TMP_BIN/crun"
chmod +x "$TMP_BIN/crun"

# CNI plugins
mkdir -p "$TMPDIR/cni-plugins"
download_component cni-plugins "$TMPDIR_CRIO/cni-plugins.tgz"
tar xfz "$TMPDIR_CRIO/cni-plugins.tgz" -C "$TMPDIR/cni-plugins"

# crictl
download_component cri-tools "$TMPDIR_CRIO/crictl.tar.gz"
tar xfz "$TMPDIR_CRIO/crictl.tar.gz" -C "$TMP_BIN"

# crio-credential-provider
download_component crio-credential-provider "$TMP_BIN/crio-credential-provider"
chmod +x "$TMP_BIN/crio-credential-provider"

# Check the architectures of the binaries
if [[ $ARCH == "$ARCH_ARM64" ]]; then
    ELF_ARCH=aarch64
elif [[ $ARCH == "$ARCH_PPC64LE" ]]; then
    ELF_ARCH=PowerPC
elif [[ $ARCH == "$ARCH_S390X" ]]; then
    ELF_ARCH=S/390
else
    ELF_ARCH=x86-64
fi
for FILE in "$TMP_BIN"/*; do
    if ! file "$FILE" | grep -q "$ELF_ARCH"; then
        echo "$FILE is not of required arch $ELF_ARCH"
        exit 1
    fi
    if ! file "$FILE" | grep static; then
        echo "$FILE is not statically linked"
        exit 1
    fi
    if ! file "$FILE" | grep -q stripped; then
        echo "$FILE is not stripped"
        exit 1
    fi
done

# Create the SBOM
pushd "$ARCHIVE_PATH"
SPDX_FILE="$ARCHIVE.spdx.json"
bom generate \
    --format spdx3-json \
    --name CRI-O \
    --namespace "https://storage.googleapis.com/cri-o/artifacts/$SPDX_FILE" \
    -d "$CRIODIR" \
    -o "$SPDX_FILE"

# Create the archive
rm -f "$ARCHIVE"
tar cfz "$ARCHIVE" "$CRIODIR"
rm -rf "$TMPDIR"
echo "Created $ARCHIVE_PATH/$ARCHIVE"
sha256sum "$ARCHIVE" >"$ARCHIVE_SHA256SUM"
echo "Created $ARCHIVE_PATH/$ARCHIVE_SHA256SUM"
rm -rf "$TMPDIR"

# Test the archive
echo "Testing archive"
tar xf "$ARCHIVE"
SPDX_PATH="$ARCHIVE_PATH/$SPDX_FILE"
bom document outline "$SPDX_PATH"
bom validate -e "$SPDX_PATH" -d "$CRIODIR"
pushd "$TMPDIR"
export DESTDIR=test/
./install

# The installer records every file it writes so that it can uninstall them
# again. Both views have to agree, otherwise uninstalling leaves files behind.
RECORDED=$(tr -s / <~/.crio-install | sort)
INSTALLED=$(find test -type f | tr -s / | sort)
if [[ "$RECORDED" != "$INSTALLED" ]]; then
    echo "installed files do not match the ones recorded by the installer"
    diff <(echo "$RECORDED") <(echo "$INSTALLED") || true
    exit 1
fi
popd
rm -rf "$TMPDIR"
