#!/usr/bin/env bash
set -euox pipefail

retry_3() {
    for _ in 1 2 3; do
        if "$@"; then
            return
        else
            sleep 1
        fi
    done
    exit 1
}

curl_retry() {
    curl -sSfL --retry 5 --retry-delay 3 "$@"
}

verify_sha256() {
    echo "$2  $1" | sha256sum -c -
}

install_osc() {
    OSC_VERSION=1.28.0
    OSC_SHA256=c2c6b0a11991250a4beb26b02628d9c668d94591f65e03a5f903b29c699084c1
    # The build and runtime dependencies come from the distribution, so that
    # pip does not pull anything unpinned from PyPI. ruamel.yaml is required
    # because of https://github.com/openSUSE/osc/issues/1819

    sudo apt-get update -y
    sudo apt-get install -y python3-pip python3-setuptools python3-cryptography python3-rpm python3-ruamel.yaml python3-urllib3

    local workdir
    workdir=$(mktemp -d)

    curl_retry "https://github.com/openSUSE/osc/archive/refs/tags/$OSC_VERSION.tar.gz" -o "$workdir/osc.tar.gz"
    verify_sha256 "$workdir/osc.tar.gz" "$OSC_SHA256"
    sudo python3 -m pip install --no-deps --no-build-isolation --break-system-packages --root-user-action=ignore "$workdir/osc.tar.gz"
    rm -rf -- "$workdir"
}

install_krel() {
    KREL_VERSION=v0.22.0
    KREL_SHA256=a67b8aeca616b94d1bc2c14c4e2851b796538601c735dd7391c39d7655632c48
    install_binary https://github.com/kubernetes/release/releases/download/$KREL_VERSION/krel-amd64-linux krel $KREL_SHA256
}

install_binary() {
    curl_retry "$1" -o "$2"
    verify_sha256 "$2" "$3"
    chmod +x "$2"
    sudo cp "$2" /usr/local/bin
    rm "$2"
    /usr/local/bin/"$2" version
}
