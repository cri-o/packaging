# -*- mode: ruby -*-
# vi: set ft=ruby :

# Vagrant box for testing
Vagrant.configure("2") do |config|
  config.vm.box = "centos/stream10"
  box_version = "20260728.1"
  box_url = "https://cloud.centos.org/centos/10-stream/x86_64/images/CentOS-Stream-Vagrant-10-#{box_version}.x86_64.vagrant"
  memory = 8192
  cpus = 4

  config.vm.provider :virtualbox do |v, override|
    override.vm.box_url = "#{box_url}-virtualbox.box"
    v.memory = memory
    v.cpus = cpus
    # Log the serial console, which the kernel of the box writes to, to show
    # why a boot fails, see scripts/test-kubernetes.
    v.customize ["modifyvm", :id, "--uart1", "0x3F8", "4", "--uartmode1", "file", File.join(__dir__, ".vagrant", "console.log")]
  end

  config.vm.provider :libvirt do |v, override|
    override.vm.box_url = "#{box_url}-libvirt.box"
    v.memory = memory
    v.cpus = cpus
  end

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provision "file", source: "../scripts", destination: "/tmp/provision"
  # Defaults to prerelease:/main when run outside of CI, see scripts/test-kubernetes
  project_path = ENV.fetch("PROJECT_PATH", "prerelease:/main")

  config.vm.provision "install packages", type: "shell", env: {"PROJECT_PATH" => project_path}, inline: "cd /tmp/provision && ./install-rpm.sh", run: "once", reboot: true
  config.vm.provision "run tests", type: "shell", inline: "/tmp/provision/test.sh", run: "once"
end
